# Copy this file to .env and fill in the key for your chosen provider.
# .env is gitignored. Never commit a real key.

# =============================================================================
# PROVIDER
# =============================================================================
# Which LLM backend to use. This is the one line you change to switch.
#   gemini    - Google Gemini, free tier (default)
#   anthropic - Anthropic Claude, paid
LLM_PROVIDER=gemini

# =============================================================================
# GEMINI (required when LLM_PROVIDER=gemini)
# =============================================================================
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL - model ids. Leave blank and run
#     python -m app.llm.models --write
# to discover which models your key can actually use. Only free-tier families
# are considered: Flash-Lite for extraction, Flash for answers. Never guessed.
GEMINI_EXTRACTION_MODEL=
GEMINI_ANSWER_MODEL=

# =============================================================================
# ANTHROPIC (required only when LLM_PROVIDER=anthropic)
# =============================================================================
# Key: https://console.anthropic.com/settings/keys
# Not needed at all while LLM_PROVIDER=gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=
ANTHROPIC_ANSWER_MODEL=

# =============================================================================
# OPTIONAL
# =============================================================================
# Force a specific model regardless of provider (overrides the values above).
GRAPHRAG_EXTRACTION_MODEL=
GRAPHRAG_ANSWER_MODEL=

# Where local data lives (relative paths resolve against the project root).
GRAPHRAG_DATA_DIR=data

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
GRAPHRAG_LOG_LEVEL=INFO

# =============================================================================
# ACCESS CONTROL (required - the app refuses to start without APP_PASSWORD)
# =============================================================================
# The single shared password protecting the whole app.
APP_PASSWORD=

# Signs the session cookie. Any long random string. If left blank the app
# generates one at startup, which works but logs everyone out on every restart.
SESSION_SECRET=

# Set to false for local http development: browsers refuse a Secure cookie
# over a plain http connection. Leave true (or unset) in production.
GRAPHRAG_COOKIE_SECURE=true

# Set to true only when running behind a trusted reverse proxy (Render), so
# rate limiting sees the real visitor IP instead of the proxy's. Leaving it
# false when directly exposed prevents anyone spoofing a header to dodge limits.
GRAPHRAG_TRUST_PROXY=false

# OPTIONAL - the embedding model, discovered the same way (D16). Leave blank
# and run `python -m app.llm.models --write`.
GEMINI_EMBEDDING_MODEL=
