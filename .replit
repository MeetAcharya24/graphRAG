# Replit run configuration.
#
# Two things make the app reachable from the public URL:
#   --host 0.0.0.0   listen on all interfaces, not just localhost
#   --port $PORT     use the port Replit assigns (8080 if unset)
# Binding 127.0.0.1 or a hardcoded port is the classic "deploy looks broken"
# mistake: the process runs fine and nothing can reach it.

run = "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"

modules = ["python-3.13"]

[deployment]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]

[[ports]]
localPort = 8080
externalPort = 80
